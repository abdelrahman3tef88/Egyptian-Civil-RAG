# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# Editors / IDE
.vscode/
.idea/

# Notebooks checkpoints
.ipynb_checkpoints/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Raw documents (user-provided PDFs are not committed)
*.pdf

# Data: keep directory structure only, never commit contents
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated runtime/indexing artifacts
artifacts/vector_store/*
!artifacts/vector_store/.gitkeep

# Experiment indexes (one isolated Chroma index per experiment arm)
artifacts/experiment_indexes/

# MLflow local tracking store + served artifacts
mlflow.db
mlruns/

# Experiment reports (generated by the MLflow workflow)
reports/mlflow/best_config.json
reports/mlflow/evaluation_results/*
!reports/mlflow/evaluation_results/.gitkeep
reports/mlflow/artifacts/*
!reports/mlflow/artifacts/.gitkeep

.dvc/config.local


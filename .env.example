# Environment configuration for the RAG project.
# No values are configured on Day 1; variables are introduced progressively
# as the corresponding pipeline components are implemented.

# --- LLM ---
# Google Gemini key. It is used by BOTH roles in generation/llm.py:
#   * the GENERATION model that answers RAG questions
#     (generation.model, default gemini/gemini-3.1-flash-lite), and
#   * the FAITHFULNESS JUDGE model that scores an answer against the
#     retrieved contexts (generation.judge_model, same default).
GEMINAI_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# --- Embeddings ---
# EMBEDDING_MODEL=

# --- Vector store ---
# VECTOR_STORE_PATH=artifacts/vector_store

# --- Serving layer (service/) ------------------------------------
# هنا بنحفظ إعدادات الـremote vLLM server اللي هيشتغل على GPU بعدين.
# متحطّش URL أو API key حقيقي هنا: .env.example بيتكتب في الـgit
# وإنما الملف الحقيقي (.env) محجوب من الـgit.
#
# Resolution order (service/llm_client.py get_vllm_config):
#   environment variable  ->  configs/config.yaml (vllm section)  ->  local default
# The environment ALWAYS wins, so the real remote URL, model and API key
# are never read from a file that is committed to git.
#
# VLLM_BASE_URL must point at the remote vLLM OpenAI-compatible API
# (the /v1 path), NOT the BentoML service port.
# Inside docker compose set it to the REMOTE GPU host, e.g.
#   VLLM_BASE_URL=http://host.docker.internal:8000/v1   (GPU on the same host)
#   VLLM_BASE_URL=http://<gpu-host>:8000/v1             (GPU on another host)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=
VLLM_API_KEY=
# timeout_seconds and max_tokens are read from configs/config.yaml
# (vllm.timeout_seconds, vllm.max_tokens) and applied to the OpenAI
# client. They are NOT environment variables; edit config.yaml to change
# them. VLLM_MODEL/BASE_URL are only overridden here when needed.

# --- FastAPI gateway -> BentoML --------------------------------
# Where the gateway forwards validated questions (BentoML /ask_json).
BENTOML_BASE_URL=http://127.0.0.1:3000
BENTOML_TIMEOUT=300
# Set to 0/false to disable the input PII guardrail (default: enabled).
GUARDRAIL_ENABLED=1
# Set to 1 to make the OUTPUT guardrail withhold answers containing a
# national ID instead of masking it (default: mask and continue).
GUARDRAIL_OUTPUT_BLOCK=0

# --- BentoML Prometheus metrics ---------------------------------
# Port of the BentoML process's own /metrics endpoint (0 = disable).
BENTOML_METRICS_PORT=9001

# --- Langfuse tracing -------------------------------------------
# Keep both keys in the environment, never in source control.
# Leave empty to disable tracing (all helpers become no-ops).
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_RELEASE=

# --- Online RAGAS faithfulness (LLM-as-judge per request) -------
# 1 = evaluate every /ask_json request (adds latency + judge cost).
# 0 = skip online evaluation. Unset = fall back to
# configs/config.yaml evaluation.enabled.
ONLINE_EVAL_ENABLED=0
# Optional Gemini judge model override for evaluation (unused keys
# fall back to configs/config.yaml generation.judge_model).
# GEMINAI_API_KEY is used by the judge; see the top of this file.

# --- Embedding drift --------------------------------------------
# 0 disables the per-request drift check (default: enabled; it is
# skipped automatically when the baseline file is missing).
DRIFT_ENABLED=1
# Threshold for a potential-drift flag. PROVISIONAL until calibrated
# offline with monitoring/evaluate_embedding_drift.py calibrate_threshold().
# A query below the threshold is RECORDED, never rejected.
# DRIFT_THRESHOLD=0.45

# --- Smoke test runner ------------------------------------------
# SMOKE_BASE_URL=http://127.0.0.1:8000
# SMOKE_TIMEOUT=120

# --- Optional model pricing (USD per 1,000 tokens) ----------------
# Set BOTH to enable the rag_estimated_cost_usd_total metric and the
# Grafana estimated-cost panel. Unset = no cost is ever recorded.
# (Do NOT invent prices - use your provider's published figures.)
# MODEL_PRICING_INPUT_PER_1K_USD=
# MODEL_PRICING_OUTPUT_PER_1K_USD=
